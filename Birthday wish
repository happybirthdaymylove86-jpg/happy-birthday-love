<!-- PAGE 4 -->
<section id="ringpage" hidden>
  <div class="frame" aria-hidden="true"></div>
  <h2 class="rnote">HAPPY BIRTHDAY KAKA</h2>
  <div class="stage">
    <div class="cam">
      <div class="scene">
        <div class="floorplane" aria-hidden="true"><div class="floorglow"></div><div class="ctext">I LOVE YOU<br>SO MUCH <span class="h">&#10084;</span></div></div>
        <div class="ring" id="ring"></div>
      </div>
    </div>
  </div>

  <div class="env" id="env">
    <div class="back"></div>
    <div class="pocket"></div>
    <div class="flap"></div>
    <button type="button" class="openbtn" id="openBtn" aria-label="Open the letter">OPEN</button>
  </div>
  <div id="letter" hidden role="dialog" aria-modal="true" aria-label="Birthday letter">
    <div class="paper">
      <h3>Happy Birthday Kaka! &#127874;</h3>
      <p>Aaj ka din bohot khaas hai, kyun ke aaj aap ki wajah se meri zindagi mein khushiyan hain.</p>
      <p>Allah aap ko hamesha khush, healthy aur kamyab rakhe. Aap ki har dua qubool ho aur har khwahish poori ho.</p>
      <p>Aap meri zindagi ka sab se khoobsurat hissa ho. I love you so much &#10084;</p>
      <div class="sign">Hamesha aap ka &#10084;</div>
      <button type="button" class="close" id="closeLetter">CLOSE</button>
    </div>
  </div>
</section>

<script>
(function () {
  /* ---------- Lock logic ---------- */
  var lock = document.getElementById('lock');
  var celebrate = document.getElementById('celebrate');
  var lockForm = document.getElementById('lockForm');
  var lockMsg = document.getElementById('lockMsg');
  var slots = document.querySelectorAll('.slot');
  var code = '';
  var PASSWORD = '1711';

  function paint() { slots.forEach(function (s, i) { s.classList.toggle('on', i < code.length); }); }
  function press(k) {
    if (k === 'back') code = code.slice(0, -1);
    else if (code.length < 4) code += k;
    lockMsg.textContent = '';
    paint();
  }
  function check() {
    if (code === PASSWORD) {
      lock.hidden = true;
      celebrate.hidden = false;
      window.scrollTo(0, 0);
      startCelebration();
    } else {
      lockMsg.textContent = 'That is not the right date. Try again.';
      code = ''; paint();
      lockForm.classList.remove('shake');
      void lockForm.offsetWidth;
      lockForm.classList.add('shake');
    }
  }

  var cakeSvg = '<svg viewBox="-50 -50 100 100" aria-hidden="true">'
    + '<circle class="plate" r="47"/>'
    + '<rect class="kcandle" x="-2.5" y="-30" width="5" height="16" rx="1.5"/>'
    + '<path class="kflame" d="M0 -43c-4 4-4 8 0 11 4-3 4-7 0-11z"/>'
    + '<rect class="kbase" x="-30" y="-6" width="60" height="38" rx="8"/>'
    + '<path class="kfrost" d="M-30 2c0-6 4-8 8-8h44c4 0 8 2 8 8v2c-4 4-8 0-12 4s-8 0-12 4-8 0-12 4-8 0-12 4-8 0-12-4z"/>'
    + '</svg>';
  document.querySelectorAll('.key').forEach(function (b) {
    b.innerHTML = '<span class="lbl">' + b.innerHTML + '</span>';
  });
  document.querySelectorAll('.key[data-k]').forEach(function (b) {
    b.addEventListener('click', function () { var k = b.getAttribute('data-k'); if (k === 'enter') check(); else press(k); });
  });
  document.addEventListener('keydown', function (e) {
    if (lock.hidden) return;
    if (/^[0-9]$/.test(e.key)) press(e.key);
    else if (e.key === 'Backspace') press('back');
    else if (e.key === 'Enter') { e.preventDefault(); check(); }
  });

  /* ---------- Page 3: floating photos ---------- */
  var gallery = document.getElementById('gallery');
  var inGallery = false;
  document.getElementById('nextBtn').addEventListener('click', function () {
    celebrate.hidden = true; gallery.hidden = false; inGallery = true; window.scrollTo(0, 0);
  });


  /* ---------- Page 4: 3D ring ---------- */
  var ringPage = document.getElementById('ringpage');
  var RING_IMGS = ["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];
  (function buildRing() {
    var ring = document.getElementById('ring'), N = 10;
    for (var i = 0; i < N; i++) {
      var c = document.createElement('div'); c.className = 'card';
      c.style.setProperty('--k', i); c.style.transform = 'rotateY(' + (i * 360 / N) + 'deg) translateZ(var(--r))';
      var im = document.createElement('img'); im.src = RING_IMGS[i % RING_IMGS.length]; im.alt = 'Memory ' + (i + 1);
      c.appendChild(im); ring.appendChild(c);
    }
  })();
  document.getElementById('gNext').addEventListener('click', function () {
    gallery.hidden = true; ringPage.hidden = false; inGallery = true; window.scrollTo(0, 0);
  });


  /* ---------- Letter ---------- */
  var env = document.getElementById('env'), letter = document.getElementById('letter');
  document.getElementById('openBtn').addEventListener('click', function () {
    env.classList.add('open');
    setTimeout(function () { letter.hidden = false; }, 650);
  });
  function closeLetter() { letter.hidden = true; env.classList.remove('open'); }
  document.getElementById('closeLetter').addEventListener('click', closeLetter);
  letter.addEventListener('click', function (e) { if (e.target === letter) closeLetter(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !letter.hidden) closeLetter(); });

  /* ---------- Canvas animation ---------- */
  var cv = document.getElementById('fx');
  var ctx = cv.getContext('2d');
  var W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var stars = [], balloons = [], bursts = [], confetti = [];
  var active = false, t0 = 0, nextBurst = 0;
  var BCOLORS = ['#ff3b3b', '#2f7bff', '#ffd23d', '#3fcf4a', '#a23bd8', '#ff8a1f'];
  var FCOLORS = ['#ff4d4d', '#ffd23d', '#38e1ff', '#ff9f1a', '#ffffff', '#7dff4a'];
  var CCOLORS = ['#ff4d4d', '#ffd23d', '#38e1ff', '#ff9f1a', '#ff7ad9', '#7dff4a', '#ffffff'];

  function resize() {
    W = window.innerWidth; H = window.innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  for (var i = 0; i < 140; i++) {
    stars.push({ x: Math.random(), y: Math.random(), r: Math.random() * 1.6 + .4, ph: Math.random() * 6.28, sp: .6 + Math.random() * 1.6 });
  }

  function initBalloons() {
    balloons = [];
    var xs = [0.13, 0.27, 0.41, 0.59, 0.73, 0.87];
    for (var i = 0; i < 6; i++) {
      balloons.push({ xf: xs[i], c: BCOLORS[i], ph: Math.random() * 6.28, delay: i * 0.15, y: 1.2 });
    }
  }
  function initConfetti() {
    confetti = [];
    var n = reduce ? 90 : 170;
    for (var i = 0; i < n; i++) {
      confetti.push({ x: Math.random(), y: Math.random(), s: 3 + Math.random() * 3, vy: .015 + Math.random() * .03, ph: Math.random() * 6.28, c: CCOLORS[(Math.random() * CCOLORS.length) | 0], sq: Math.random() > .5 });
    }
  }
  var spots = [
    { x: .2, c: '#ffb02e', c2: '#ff5a3d' },
    { x: .5, c: '#38e1ff', c2: '#7dff4a' },
    { x: .8, c: '#ff6ad5', c2: '#a58bff' }
  ];
  var nextFw = [0, 0, 0];
  function spawnSpot(i, now) {
    var sp = spots[i], sc = Math.min(W, 520) / 380;
    var f = { x: W * sp.x, y: H * 0.095, born: now, life: 2000, rays: 30, len: 46 * sc, c: sp.c, c2: sp.c2 };
    if (reduce) { f.life = 1e12; f.born = now - 0.3e12; }
    bursts.push(f);
  }
  function startCelebration() {
    initBalloons(); initConfetti();
    bursts = [];
    active = true; t0 = performance.now();
    nextFw = [t0 + 200, t0 + 700, t0 + 1200];
    if (reduce) for (var i = 0; i < 3; i++) { spawnSpot(i, t0); nextFw[i] = Infinity; }
  }

  function drawBalloon(b, now) {
    var s = Math.min(W, 520) / 380;
    var rx = 22 * s, ry = 28 * s;
    var targetY = H * 0.2;
    var el = Math.max(0, (now - t0) / 1000 - b.delay);
    var k = Math.min(1, el / 1.6); k = 1 - Math.pow(1 - k, 3);
    var y = (H + 90) + (targetY - (H + 90)) * k + Math.sin(now / 900 + b.ph) * 7 * s;
    var x = W * b.xf + Math.sin(now / 1300 + b.ph) * 6 * s;
    // string
    ctx.strokeStyle = 'rgba(255,255,255,.75)'; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(x, y + ry + 6 * s);
    var sw = Math.sin(now / 700 + b.ph) * 7 * s;
    ctx.bezierCurveTo(x + sw, y + ry + 30 * s, x - sw, y + ry + 55 * s, x + sw * .5, y + ry + 82 * s);
    ctx.stroke();
    // knot
    ctx.fillStyle = b.c;
    ctx.beginPath(); ctx.moveTo(x, y + ry - 2); ctx.lineTo(x - 5 * s, y + ry + 7 * s); ctx.lineTo(x + 5 * s, y + ry + 7 * s); ctx.closePath(); ctx.fill();
    // body
    ctx.beginPath(); ctx.ellipse(x, y, rx, ry, 0, 0, 6.2832); ctx.fill();
    // highlight
    ctx.fillStyle = 'rgba(255,255,255,.4)';
    ctx.beginPath(); ctx.ellipse(x - rx * .38, y - ry * .38, rx * .2, ry * .3, -.5, 0, 6.2832); ctx.fill();
  }

  function drawBurst(f, now) {
    var p = (now - f.born) / f.life;
    if (p >= 1) return false;
    var e = 1 - Math.pow(1 - Math.min(1, p / .35), 2);
    var r0 = f.len * e * .35, r1 = f.len * e;
    ctx.globalAlpha = p < .62 ? 1 : Math.max(0, (1 - p) / .38);
    ctx.lineWidth = 2; ctx.lineCap = 'round';
    for (var i = 0; i < f.rays; i++) {
      var a = (i / f.rays) * 6.2832;
      var long = (i % 2 === 0);
      var rr = long ? r1 : r1 * .62;
      ctx.strokeStyle = long ? f.c : f.c2;
      ctx.beginPath();
      ctx.moveTo(f.x + Math.cos(a) * r0, f.y + Math.sin(a) * r0);
      ctx.lineTo(f.x + Math.cos(a) * rr, f.y + Math.sin(a) * rr);
      ctx.stroke();
      if (long) { ctx.fillStyle = f.c; ctx.beginPath(); ctx.arc(f.x + Math.cos(a) * (rr + 4), f.y + Math.sin(a) * (rr + 4), 1.6, 0, 6.2832); ctx.fill(); }
    }
    ctx.globalAlpha = 1;
    return true;
  }

  function frame(now) {
    ctx.clearRect(0, 0, W, H);
    // stars
    for (var i = 0; i < stars.length; i++) {
      var s = stars[i];
      var a = reduce ? .8 : .35 + .65 * (0.5 + 0.5 * Math.sin(now / 1000 * s.sp + s.ph));
      ctx.globalAlpha = a; ctx.fillStyle = '#fff';
      ctx.beginPath(); ctx.arc(s.x * W, s.y * H, s.r, 0, 6.2832); ctx.fill();
    }
    ctx.globalAlpha = 1;

    if (active) {
      // confetti
      for (var j = 0; j < confetti.length; j++) {
        var c = confetti[j];
        if (!reduce) { c.y += c.vy / 60; if (c.y > 1.02) { c.y = -0.02; c.x = Math.random(); } }
        var cx = c.x * W, cy = c.y * H;
        ctx.fillStyle = c.c;
        ctx.globalAlpha = reduce ? .85 : .45 + .5 * (0.5 + 0.5 * Math.sin(now / 700 + c.ph * 3));
        ctx.save(); ctx.translate(cx, cy); ctx.rotate(.785);
        ctx.fillRect(-c.s / 2, -c.s / 2, c.s, c.s);
        ctx.restore();
      }
      ctx.globalAlpha = 1;
      // fireworks
      if (!inGallery) for (var q = 0; q < 3; q++) { if (now > nextFw[q]) { spawnSpot(q, now); nextFw[q] = now + 2700; } }
      if (inGallery) bursts = []; else bursts = bursts.filter(function (f) { return drawBurst(f, now); });
      // balloons
      if (!inGallery) for (var k = 0; k < balloons.length; k++) drawBalloon(balloons[k], now);
    }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>
