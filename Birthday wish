<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Happy Birthday My Love</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Dancing+Script:wght@600&display=swap">
<style>
:root {
  --bg1: #0b1245;
  --bg2: #050824;
  --gold: #ffc83d;
  --pink: #ff8fb8;
  --cream: #fff7ee;
  --ink: #2a1030;
  --text: #f3f6ff;
  --muted: #9fb0ff;
  --accent: #ff4d8d;
  --font-display: "Montserrat", "Trebuchet MS", system-ui, sans-serif;
  --font-script: "Dancing Script", "Courier New", cursive;
}
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body {
  background: radial-gradient(ellipse at 50% 0%, var(--bg1) 0%, var(--bg2) 75%);
  color: var(--text);
  font-family: var(--font-display);
  overflow-x: hidden;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
canvas#fx { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
section { position: relative; z-index: 1; min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px 16px; }
[hidden] { display: none !important; }

/* ---------- Page 1: lock ---------- */
.lockbox { width: 100%; max-width: 360px; display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
.lockh { margin: 0; font-weight: 800; font-size: clamp(1.9rem, 9vw, 2.7rem); line-height: 1.12; letter-spacing: .01em; text-wrap: balance; }
.lockh .love { display: block; color: var(--gold); text-shadow: 0 0 18px rgba(255,200,61,.55); }
.datelabel { margin: 0; color: var(--muted); letter-spacing: .16em; font-size: 13px; text-transform: uppercase; }
.pinrow { display: flex; gap: 16px; justify-content: center; margin: 2px 0 6px; }
.slot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--gold); background: transparent; transition: background .12s, transform .12s; }
.slot.on { background: var(--gold); transform: scale(1.15); box-shadow: 0 0 10px rgba(255,200,61,.7); }
.pad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; width: min(100%, 300px); }
.key { position: relative; border: 2px solid var(--gold); background: linear-gradient(160deg, #1a2470, #0f1650); padding: 0; aspect-ratio: 1.6 / 1; border-radius: 18px; box-shadow: 0 0 12px rgba(255,200,61,.25), inset 0 0 10px rgba(255,143,184,.15); cursor: pointer; font-family: var(--font-display); font-weight: 800; font-size: 20px; touch-action: manipulation; -webkit-tap-highlight-color: transparent; transition: transform .12s; }
.key:active { transform: scale(.92); }
.key:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
.key svg { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
.plate { fill: #121a5c; stroke: var(--gold); stroke-width: 3; }
.kbase { fill: var(--pink); }
.kfrost { fill: var(--cream); }
.kcandle { fill: var(--gold); }
.kflame { fill: #ff9f1a; transform-box: fill-box; transform-origin: 50% 100%; animation: flick .5s ease-in-out infinite alternate; }
.key .lbl { display: block; text-align: center; line-height: 1; color: var(--pink); font-size: 26px; }
.key.fn .lbl { font-size: 18px; }
.key.enter .kbase { fill: var(--accent); }
.key.enter .lbl { color: #fff; font-size: 11px; }
.lockbox { gap: 10px; }
.panda { width: min(56vw, 210px); height: auto; display: block; border-radius: 24px; border: 2px solid var(--gold); background: #faf7f7; box-shadow: 0 0 22px rgba(255,200,61,.4), 0 8px 22px rgba(0,0,0,.45); }
.key.enter { background: linear-gradient(160deg, #ff6aa0, var(--accent)); }
.key.enter .lbl { font-size: 14px; }
.key.fn .lbl { font-size: 24px; }
.msg { margin: 0; min-height: 1.6em; color: #ff8aa8; font-size: 14px; }
.shake { animation: shake .4s; }
@keyframes shake { 20%, 60% { transform: translateX(-8px); } 40%, 80% { transform: translateX(8px); } }
@keyframes flick { from { transform: scale(1) rotate(-3deg); } to { transform: scale(1.14, .92) rotate(3deg); } }

/* ---------- Page 2: celebration ---------- */
#celebrate { justify-content: space-between; padding-top: 40vh; padding-bottom: 34px; }
.frame { position: fixed; z-index: 1; pointer-events: none; inset: calc(10px + env(safe-area-inset-top, 0px)) 10px calc(10px + env(safe-area-inset-bottom, 0px)) 10px; border: 2px solid #2f80ff; border-radius: 18px; box-shadow: 0 0 14px rgba(47,128,255,.75), inset 0 0 22px rgba(47,128,255,.35); }
.hb { margin: 0; text-align: center; font-weight: 800; font-size: clamp(1.2rem, 6vw, 2.6rem); white-space: nowrap; color: var(--gold); text-shadow: 0 0 18px rgba(255,200,61,.5); letter-spacing: .02em; opacity: 0; animation: rise .9s .5s ease-out forwards; }
.wish { margin: 10px 0 0; text-align: center; font-family: "Courier New", Courier, monospace; font-style: italic; font-size: clamp(.8rem, 3.9vw, 1.3rem); color: #fff; opacity: 0; animation: rise .9s 1.1s ease-out forwards; }
.cakewrap { width: min(62vw, 240px); margin-top: auto; opacity: 0; animation: rise .9s 1.6s ease-out forwards; }
.cakewrap svg { width: 100%; height: auto; display: block; }
.cflame { fill: #ff9f1a; transform-box: fill-box; transform-origin: 50% 100%; animation: flick .45s ease-in-out infinite alternate; }
.cflame:nth-of-type(2) { animation-delay: .1s; }
.cflame:nth-of-type(3) { animation-delay: .2s; }
.cflame:nth-of-type(4) { animation-delay: .3s; }
@keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
.textblock { text-align: center; }


/* ---------- Page 3: floating circle photos ---------- */
#gallery { padding: 0; overflow: hidden; justify-content: flex-start; height: 100dvh; }
.gtitle { position: absolute; z-index: 3; top: calc(34px + env(safe-area-inset-top, 0px)); left: 0; right: 0; margin: 0; text-align: center; font-weight: 800; font-size: clamp(1.3rem, 6.5vw, 2.4rem); color: var(--gold); text-shadow: 0 0 18px rgba(255,200,61,.55); }
.gsub { position: absolute; z-index: 3; top: calc(34px + env(safe-area-inset-top, 0px) + 2.6rem); left: 0; right: 0; margin: 0; text-align: center; font-family: var(--font-script); font-size: 1.5rem; color: var(--pink); }
.floater { position: absolute; z-index: 2; bottom: -300px; left: 0; width: 100%; height: 0; pointer-events: none; opacity: 0; animation: floatUp 14s linear infinite; animation-delay: calc(var(--i) * 2.8s); }
.sway { position: absolute; bottom: 0; width: var(--d); left: calc(var(--x) - var(--d) / 2); animation: sway 3.4s ease-in-out infinite alternate; }
.circ { position: relative; width: var(--d); height: var(--d); border-radius: 50%; overflow: hidden; border: 4px solid var(--gold); box-shadow: 0 0 22px rgba(255,200,61,.45), 0 8px 24px rgba(0,0,0,.5); background: #121a5c; }
.circ img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; display: block; }
.pill { position: relative; z-index: 1; width: max-content; max-width: 100%; margin: -16px auto 0; padding: 5px 16px; border-radius: 999px; background: var(--accent); border: 2px solid #fff; color: #fff; font-weight: 800; font-size: 12px; letter-spacing: .08em; box-shadow: 0 4px 12px rgba(0,0,0,.4); }
.balloon { position: absolute; z-index: 2; right: -16%; top: -26%; width: 34%; height: auto; animation: sway 2.6s ease-in-out infinite alternate-reverse; }
@keyframes floatUp {
  0% { transform: translateY(0) scale(.85); opacity: 0; }
  5% { opacity: 1; }
  80% { opacity: 1; }
  12% { transform: translateY(calc(-12dvh - 36px)) scale(1); }
  100% { transform: translateY(calc(-100dvh - 300px)) scale(1); opacity: 0; }
}
@keyframes sway { from { transform: translateX(-10px) rotate(-2deg); } to { transform: translateX(10px) rotate(2deg); } }
#celebrate .textblock { position: relative; z-index: 2; }
.sway { --d: min(47vw, 196px) !important; }
.circ { animation: glow 2.2s ease-in-out infinite alternate; }
.circ::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: linear-gradient(135deg, rgba(255,255,255,.28) 0%, rgba(255,255,255,0) 40%, rgba(255,143,184,.18) 100%); pointer-events: none; }
.pill { background: linear-gradient(90deg, #ff4d8d, #ff7aa8); }
@keyframes glow { from { box-shadow: 0 0 14px rgba(255,200,61,.35), 0 8px 24px rgba(0,0,0,.5); } to { box-shadow: 0 0 34px rgba(255,200,61,.8), 0 0 60px rgba(255,143,184,.35), 0 8px 24px rgba(0,0,0,.5); } }
.heart { position: absolute; z-index: 1; bottom: -40px; left: var(--hx); font-size: var(--hs); color: var(--pink); opacity: 0; pointer-events: none; text-shadow: 0 0 10px rgba(255,143,184,.7); animation: heartUp var(--hd) ease-in infinite; animation-delay: var(--hl); }
@keyframes heartUp { 0% { transform: translateY(0) scale(.6); opacity: 0; } 12% { opacity: .85; } 85% { opacity: .6; } 100% { transform: translateY(-105dvh) scale(1.1) rotate(14deg); opacity: 0; } }
.nextbtn { margin-top: 14px; padding: 11px 26px; border-radius: 999px; border: 2px solid var(--gold); background: var(--accent); color: #fff; font: 800 14px var(--font-display); letter-spacing: .08em; cursor: pointer; touch-action: manipulation; opacity: 0; animation: rise .9s 2.2s ease-out forwards; }
.nextbtn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

@media (prefers-reduced-motion: reduce) {
  .nextbtn { animation: none; opacity: 1; }
  #gallery { overflow-y: auto; height: auto; padding: 120px 16px 30px; }
  .floater { position: relative; bottom: auto; height: auto; opacity: 1; animation: none; margin-bottom: 40px; }
  .sway { position: relative; left: auto; margin: 0 auto; animation: none; }
  .balloon, .circ { animation: none; }
  .heart { display: none; }
  .kflame, .cflame, .shake { animation: none; }
  .hb, .wish, .cakewrap { animation: none; opacity: 1; }
}


/* page 1 fit-to-screen */
#lock { padding: 10px 16px; }
.lockbox { max-width: 330px; gap: 6px; }
.panda { width: min(38vw, 17dvh, 150px); }
.lockh { font-size: clamp(1.5rem, 7.4vw, 2.1rem); }
.datelabel { font-size: 11px; }
.pinrow { margin: 0 0 2px; gap: 14px; }
.pad { gap: 8px; width: min(100%, 250px); }
.key { aspect-ratio: 1.9 / 1; border-radius: 15px; }
.key .lbl { font-size: 22px; }

/* ---------- Page 4: 3D photo ring ---------- */
@property --r { syntax: '<length>'; inherits: true; initial-value: 0px; }
#ringpage { padding: 0; height: 100dvh; overflow: hidden; background: radial-gradient(ellipse at 50% 70%, rgba(255,143,184,.18), transparent 60%); }
.stage { position: relative; width: 100%; height: 100%; perspective: 800px; perspective-origin: 50% 30%; display: flex; align-items: center; justify-content: center; }
.cam { position: relative; width: 0; height: 0; transform-style: preserve-3d; transform: translateY(4vh) rotateX(-32deg); animation: camtilt 16s ease-in-out 2.4s infinite; }
.scene { --w: min(22vw, 104px); --R: calc(var(--w) * 1.85); position: absolute; left: 0; top: 0; width: 0; height: 0; transform-style: preserve-3d; animation: breathe 20s ease-in-out infinite; }
.ring { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-style: preserve-3d; animation: spin 24s linear infinite; }
.card { position: absolute; width: var(--w); height: calc(var(--w) * 1.5); left: calc(var(--w) / -2); top: calc(var(--w) * -.75); border-radius: 12px 12px 6px 6px; overflow: hidden; border: 3px solid #fff; background: #fff; box-shadow: 0 0 14px rgba(255,255,255,.35); -webkit-box-reflect: below 4px linear-gradient(transparent 62%, rgba(255,255,255,.35)); animation: pop 8s ease-in-out infinite; animation-delay: calc(var(--k) * -.8s); }
.card img { width: 100%; height: 100%; object-fit: cover; display: block; }
.floorplane { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-style: preserve-3d; transform: translateY(calc(var(--w) * .75 + 6px)) rotateX(90deg); }
.floorglow { position: absolute; left: calc(var(--R) * -1.35); top: calc(var(--R) * -1.35); width: calc(var(--R) * 2.7); height: calc(var(--R) * 2.7); border-radius: 50%; background: radial-gradient(circle, rgba(255,143,184,.38), rgba(255,200,61,.1) 55%, transparent 72%); }
.ctext { position: absolute; left: 0; top: 0; width: max-content; text-align: center; font-family: var(--font-script); font-weight: 700; line-height: 1.1; color: #fff; font-size: clamp(1.6rem, 8.4vw, 2.3rem); text-shadow: 0 0 10px var(--accent), 0 0 22px var(--accent); animation: textsway 9s ease-in-out infinite alternate; }
.ctext .h { color: var(--pink); }
.rnote { position: absolute; z-index: 3; top: calc(34px + env(safe-area-inset-top, 0px)); left: 0; right: 0; text-align: center; margin: 0; font-weight: 800; font-size: clamp(1.1rem, 5.5vw, 1.8rem); color: var(--gold); text-shadow: 0 0 18px rgba(255,200,61,.55); }
.gnext { position: fixed; left: 50%; bottom: calc(22px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 6; margin: 0; box-shadow: 0 4px 16px rgba(0,0,0,.5); opacity: 0; visibility: hidden; animation: gshow .7s 8s ease-out forwards; }
@keyframes gshow { from { opacity: 0; visibility: visible; } to { opacity: 1; visibility: visible; } }
@keyframes spin { to { transform: rotateY(360deg); } }
@keyframes camtilt { 0%,100% { transform: translateY(4vh) rotateX(-32deg); } 45%,60% { transform: translateY(2vh) rotateX(-58deg); } }
@keyframes breathe {
  0% { --r: 0px; } 10% { --r: var(--R); } 38% { --r: var(--R); }
  50% { --r: calc(var(--R) * .45); } 62% { --r: calc(var(--R) * .45); }
  76% { --r: calc(var(--R) * 1.15); } 88%,100% { --r: var(--R); }
}
@keyframes pop { 0%,70%,100% { scale: 1; filter: brightness(.9); } 82% { scale: 1.3; filter: brightness(1.1); } }
@keyframes textsway { from { transform: translate(-50%,-50%) rotateZ(-8deg); } to { transform: translate(-50%,-50%) rotateZ(8deg); } }
@media (prefers-reduced-motion: reduce) { .ring { animation-duration: 90s; } .cam, .scene, .card { animation: none; } .scene { --r: var(--R); } }

/* ---------- Letter ---------- */
.cam { transform: translateY(-3vh) rotateX(-32deg); }
@keyframes camtilt { 0%,100% { transform: translateY(-3vh) rotateX(-32deg); } 45%,60% { transform: translateY(-5vh) rotateX(-58deg); } }
.env { position: absolute; z-index: 5; left: 50%; bottom: calc(26px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); width: min(56vw, 210px); height: min(36vw, 134px); perspective: 600px; }
.env .back { position: absolute; inset: 0; border-radius: 8px; background: linear-gradient(160deg, #ffd9e6, #ff9ec1); border: 2px solid #fff; box-shadow: 0 6px 20px rgba(0,0,0,.5), 0 0 18px rgba(255,143,184,.5); }
.env .pocket { position: absolute; inset: 0; border-radius: 8px; background: linear-gradient(160deg, #ffe6ef, #ff8fb8); clip-path: polygon(0 0, 50% 58%, 100% 0, 100% 100%, 0 100%); }
.env .flap { position: absolute; left: 0; right: 0; top: 0; height: 58%; background: linear-gradient(180deg, #ff7aa8, #ffb3cd); clip-path: polygon(0 0, 100% 0, 50% 100%); transform-origin: top center; transition: transform .6s ease; }
.env.open .flap { transform: rotateX(180deg); }
.openbtn { position: absolute; z-index: 2; left: 50%; top: 58%; transform: translate(-50%, -50%); width: 58px; height: 58px; border-radius: 50%; border: 2px solid #fff; background: radial-gradient(circle at 35% 30%, #ff6aa0, var(--accent) 70%); color: #fff; font: 800 11px var(--font-display); letter-spacing: .06em; cursor: pointer; box-shadow: 0 0 0 0 rgba(255,77,141,.7), 0 4px 12px rgba(0,0,0,.5); animation: seal 1.6s ease-out infinite; touch-action: manipulation; }
.openbtn:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }
.env.open .openbtn { opacity: 0; pointer-events: none; transition: opacity .3s; }
@keyframes seal { 0% { box-shadow: 0 0 0 0 rgba(255,77,141,.7), 0 4px 12px rgba(0,0,0,.5); } 100% { box-shadow: 0 0 0 16px rgba(255,77,141,0), 0 4px 12px rgba(0,0,0,.5); } }
#letter { position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center; padding: 20px 16px; background: rgba(5,8,36,.82); overflow-y: auto; }
.paper { position: relative; width: 100%; max-width: 340px; margin: auto; padding: 26px 22px 22px; border-radius: 14px; background: linear-gradient(180deg, #fffaf2, #fff1e4); border: 3px solid var(--gold); color: var(--ink); text-align: center; box-shadow: 0 0 30px rgba(255,200,61,.5), 0 14px 40px rgba(0,0,0,.6); animation: paperIn .8s cubic-bezier(.2,.9,.3,1.1) both; }
.paper h3 { margin: 0 0 10px; font-family: var(--font-script); font-size: 2rem; color: #d63a74; line-height: 1.1; }
.paper p { margin: 0 0 10px; font-size: 14.5px; line-height: 1.6; font-weight: 500; }
.paper .sign { font-family: var(--font-script); font-size: 1.5rem; color: #d63a74; margin: 8px 0 14px; }
.paper .close { padding: 9px 24px; border-radius: 999px; border: 2px solid var(--gold); background: var(--accent); color: #fff; font: 800 12px var(--font-display); letter-spacing: .08em; cursor: pointer; }
@keyframes paperIn { from { opacity: 0; transform: translateY(60px) scale(.7); } to { opacity: 1; transform: none; } }
@media (max-height: 700px) { .scene { --w: min(19vw, 84px); } .cam { margin-top: -6vh; } }
</style>
</head>
<body>
<canvas id="fx" aria-hidden="true"></canvas>

<!-- PAGE 1 -->
<section id="lock">
  <div id="lockForm" class="lockbox">
    <img class="panda" src="data:image/jpeg;base64," alt="Cute panda with a blue cap behind a wooden fence">
    <h1 class="lockh">HAPPY BIRTHDAY 🎂 <span class="love">MY LOVE ❤</span></h1>
    <p class="datelabel">Enter your birth date</p>
    <div class="pinrow" aria-label="Entered digits"><span class="slot"></span><span class="slot"></span><span class="slot"></span><span class="slot"></span></div>
    <div class="pad" role="group" aria-label="Number keypad">
      <button type="button" class="key" data-k="1">1</button>
      <button type="button" class="key" data-k="2">2</button>
      <button type="button" class="key" data-k="3">3</button>
      <button type="button" class="key" data-k="4">4</button>
      <button type="button" class="key" data-k="5">5</button>
      <button type="button" class="key" data-k="6">6</button>
      <button type="button" class="key" data-k="7">7</button>
      <button type="button" class="key" data-k="8">8</button>
      <button type="button" class="key" data-k="9">9</button>
      <button type="button" class="key fn" data-k="back" aria-label="Delete">&#9003;</button>
      <button type="button" class="key" data-k="0">0</button>
      <button type="button" class="key enter" data-k="enter">Enter</button>
    </div>
    <p id="lockMsg" class="msg" role="alert"></p>
  </div>
</section>

<!-- PAGE 2 -->
<section id="celebrate" hidden>
  <div class="frame" aria-hidden="true"></div>
  <div class="textblock">
    <h2 class="hb">🎉 HAPPY BIRTHDAY 🎉</h2>
    <p class="wish">Wishing You Joy, Success &amp; Happiness!</p>
    <button type="button" id="nextBtn" class="nextbtn">NEXT &#10084;</button>
  </div>
  <div class="cakewrap">
    <svg viewBox="0 0 260 170" role="img" aria-label="Birthday cake with four candles">
      <rect x="77" y="30" width="9" height="40" rx="2" fill="#ffd23d"/>
      <rect x="105" y="30" width="9" height="40" rx="2" fill="#ffd23d"/>
      <rect x="146" y="30" width="9" height="40" rx="2" fill="#ffd23d"/>
      <rect x="174" y="30" width="9" height="40" rx="2" fill="#ffd23d"/>
      <path class="cflame" d="M81.5 4c-7 8-6 17 0 22 6-5 7-14 0-22z"/>
      <path class="cflame" d="M109.5 4c-7 8-6 17 0 22 6-5 7-14 0-22z"/>
      <path class="cflame" d="M150.5 4c-7 8-6 17 0 22 6-5 7-14 0-22z"/>
      <path class="cflame" d="M178.5 4c-7 8-6 17 0 22 6-5 7-14 0-22z"/>
      <rect x="60" y="68" width="140" height="26" rx="2" fill="#ffffff"/>
      <rect x="60" y="94" width="140" height="12" fill="#ff9ec1"/>
      <rect x="30" y="106" width="200" height="56" fill="#ff8fb8"/>
    </svg>
  </div>
</section>

<!-- PAGE 3 -->
<section id="gallery" hidden>
  <div class="frame" aria-hidden="true"></div>
  <h2 class="gtitle">HAPPY BIRTHDAY KAKA</h2>
  
  <span class="heart" style="--hx:8%;--hs:16px;--hd:7s;--hl:0s" aria-hidden="true">&#10084;</span><span class="heart" style="--hx:88%;--hs:20px;--hd:8s;--hl:1.5s" aria-hidden="true">&#10084;</span><span class="heart" style="--hx:20%;--hs:12px;--hd:6s;--hl:3s" aria-hidden="true">&#10084;</span><span class="heart" style="--hx:76%;--hs:14px;--hd:7.5s;--hl:4.2s" aria-hidden="true">&#10084;</span><span class="heart" style="--hx:50%;--hs:18px;--hd:9s;--hl:2.2s" aria-hidden="true">&#10084;</span><span class="heart" style="--hx:94%;--hs:12px;--hd:6.5s;--hl:5.5s" aria-hidden="true">&#10084;</span>
  <div class="floater" style="--i:0"><div class="sway" style="--x:30%;--d:min(44vw,180px)"><div class="circ"><img src="data:image/jpeg;base64," alt="Photo 1"></div><svg class="balloon" viewBox="0 0 40 70" aria-hidden="true"><path d="M20 62 C20 66 14 66 16 70" stroke="#fff" stroke-width="1.2" fill="none"/><ellipse cx="20" cy="22" rx="16" ry="20" fill="#ff3b3b"/><path d="M20 41l-3 5h6z" fill="#ff3b3b"/><ellipse cx="13" cy="14" rx="4" ry="6" fill="#fff" opacity=".4"/></svg><div class="pill">&#10084; My Love</div></div></div><div class="floater" style="--i:1"><div class="sway" style="--x:70%;--d:min(44vw,180px)"><div class="circ"><img src="data:image/jpeg;base64," alt="Photo 2"></div><svg class="balloon" viewBox="0 0 40 70" aria-hidden="true"><path d="M20 62 C20 66 14 66 16 70" stroke="#fff" stroke-width="1.2" fill="none"/><ellipse cx="20" cy="22" rx="16" ry="20" fill="#2f7bff"/><path d="M20 41l-3 5h6z" fill="#2f7bff"/><ellipse cx="13" cy="14" rx="4" ry="6" fill="#fff" opacity=".4"/></svg><div class="pill">&#10084; My Love</div></div></div><div class="floater" style="--i:2"><div class="sway" style="--x:36%;--d:min(44vw,180px)"><div class="circ"><img src="data:image/jpeg;base64," alt="Photo 3"></div><svg class="balloon" viewBox="0 0 40 70" aria-hidden="true"><path d="M20 62 C20 66 14 66 16 70" stroke="#fff" stroke-width="1.2" fill="none"/><ellipse cx="20" cy="22" rx="16" ry="20" fill="#ffd23d"/><path d="M20 41l-3 5h6z" fill="#ffd23d"/><ellipse cx="13" cy="14" rx="4" ry="6" fill="#fff" opacity=".4"/></svg><div class="pill">&#10084; My Love</div></div></div><div class="floater" style="--i:3"><div class="sway" style="--x:66%;--d:min(44vw,180px)"><div class="circ"><img src="data:image/jpeg;base64," alt="Photo 4"></div><svg class="balloon" viewBox="0 0 40 70" aria-hidden="true"><path d="M20 62 C20 66 14 66 16 70" stroke="#fff" stroke-width="1.2" fill="none"/><ellipse cx="20" cy="22" rx="16" ry="20" fill="#3fcf4a"/><path d="M20 41l-3 5h6z" fill="#3fcf4a"/><ellipse cx="13" cy="14" rx="4" ry="6" fill="#fff" opacity=".4"/></svg><div class="pill">&#10084; My Love</div></div></div><div class="floater" style="--i:4"><div class="sway" style="--x:50%;--d:min(44vw,180px)"><div class="circ"><img src="data:image/jpeg;base64," alt="Photo 5"></div><svg class="balloon" viewBox="0 0 40 70" aria-hidden="true"><path d="M20 62 C20 66 14 66 16 70" stroke="#fff" stroke-width="1.2" fill="none"/><ellipse cx="20" cy="22" rx="16" ry="20" fill="#ff8a1f"/><path d="M20 41l-3 5h6z" fill="#ff8a1f"/><ellipse cx="13" cy="14" rx="4" ry="6" fill="#fff" opacity=".4"/></svg><div class="pill">&#10084; My Love</div></div></div>
  <button type="button" id="gNext" class="nextbtn gnext">NEXT &#10084;</button>
